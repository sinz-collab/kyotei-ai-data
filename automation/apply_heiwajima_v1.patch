+def boaters_kimarite_input(racer: dict) -> dict:
+    starts = racer.get("boaters_kimarite_starts")
+    if starts in (None, "", "-"):
+        return {}
+
+    lane = int(racer.get("lane") or 0)
+    payload = {"starts": starts}
+
+    if lane == 1:
+        mapping = {
+            "escape_rate": "boaters_escape_rate",
+            "sashare_rate": "boaters_sashare_rate",
+            "makurare_rate": "boaters_makurare_rate",
+            "makurare_zashi_rate": "boaters_makurare_zashi_rate",
+        }
+    else:
+        mapping = {
+            "nigashi_rate": "boaters_nigashi_rate",
+            "sashi_rate": "boaters_sashi_rate",
+            "makuri_rate": "boaters_makuri_rate",
+            "makuri_sashi_rate": "boaters_makuri_sashi_rate",
+        }
+
+    for target_key, source_key in mapping.items():
+        value = racer.get(source_key)
+        if value not in (None, "", "-"):
+            payload[target_key] = value
+    return payload
+
