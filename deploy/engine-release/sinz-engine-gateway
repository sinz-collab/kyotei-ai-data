#!/usr/bin/env bash
set -Eeuo pipefail

# Forced SSH command. Never evaluate SSH_ORIGINAL_COMMAND as shell code.
read -r -a parts <<< "${SSH_ORIGINAL_COMMAND:-}"
[[ ${#parts[@]} -eq 3 && ${parts[0]} == apply ]] || exit 64
[[ ${parts[1]} =~ ^[a-z][a-z0-9_-]{1,24}$ ]] || exit 64
[[ ${parts[2]} =~ ^[a-f0-9]{40}$ ]] || exit 64
exec sudo -n /usr/local/sbin/sinz-engine-apply "${parts[1]}" "${parts[2]}"
