#!/usr/bin/env bash
set -euo pipefail

readonly executor=/usr/local/sbin/sinz-morning-exec
readonly original_command="${SSH_ORIGINAL_COMMAND:-}"

if [ "$original_command" = version ]; then
  printf 'executor=%s\n' "$(sha256sum "$executor" | awk '{print $1}')"
  printf 'recovery=%s\n' "$(sha256sum /opt/sinz-morning-fetch/app/automation/prepare_morning_recovery_cache.py | awk '{print $1}')"
  printf 'validator=%s\n' "$(sha256sum /opt/sinz-morning-fetch/app/automation/validate_morning_vps_artifacts.py | awk '{print $1}')"
  exit 0
fi
if [ "$original_command" = supplement-version ]; then
  printf 'executor=%s\n' "$(sha256sum "$executor" | awk '{print $1}')"
  printf 'boaters=%s\n' "$(sha256sum /opt/sinz-morning-fetch/app/automation/boaters_fetch.py | awk '{print $1}')"
  printf 'supplement_validator=%s\n' "$(sha256sum /opt/sinz-morning-fetch/app/automation/validate_boaters_supplement.py | awk '{print $1}')"
  printf 'kimarite_parser=%s\n' "$(sha256sum /opt/sinz-morning-fetch/app/automation/enrich_all_venues_kimarite.py | awk '{print $1}')"
  printf 'motor_parser=%s\n' "$(sha256sum /opt/sinz-morning-fetch/app/automation/enrich_motor_recent.py | awk '{print $1}')"
  exit 0
fi

read -r -a command_parts <<<"$original_command"
if [ "${#command_parts[@]}" -ne 3 ] && [ "${#command_parts[@]}" -ne 4 ]; then
  echo "Rejected: expected ACTION YYYY-MM-DD TARGET [RACES]." >&2
  exit 64
fi

action="${command_parts[0]}"
target_date="${command_parts[1]}"
shard="${command_parts[2]}"

case "$action" in
  dummy|fetch|recovery-all|recovery-failed) [ "${#command_parts[@]}" -eq 3 ] || exit 64 ;;
  supplement) [ "${#command_parts[@]}" -eq 4 ] || exit 64 ;;
  *) echo "Rejected: unsupported action." >&2; exit 64 ;;
esac
if [[ ! "$target_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "Rejected: invalid date." >&2
  exit 64
fi
if [ "$action" = supplement ]; then
  [[ "$shard" =~ ^(kiryu|toda|heiwajima|tokoname|biwako|naruto|shimonoseki|wakamatsu|ashiya|fukuoka|karatsu|omura)$ ]] || {
    echo "Rejected: invalid venue." >&2; exit 64;
  }
  races="${command_parts[3]}"
  [[ "$races" =~ ^([1-9]|1[0-2])(,([1-9]|1[0-2])){0,11}$ ]] || {
    echo "Rejected: invalid race list (maximum twelve)." >&2; exit 64;
  }
  exec sudo -n "$executor" "$action" "$target_date" "$shard" "$races"
fi
case "$shard" in east|west) ;; *) echo "Rejected: invalid shard." >&2; exit 64 ;; esac

exec sudo -n "$executor" "$action" "$target_date" "$shard"
