#!/usr/bin/env bash
set -euo pipefail

readonly app_root=/opt/sinz-morning-fetch/app
readonly venv_python=/opt/sinz-morning-fetch/venv/bin/python
readonly state_root=/var/lib/sinz-morning-fetch
readonly enable_file=/etc/sinz-morning-fetch/enabled
readonly guard_root=/run/sinz-morning-fetch
readonly worker_user=sinz-morning
readonly worker_group=sinz-morning

die() {
  echo "$1" >&2
  exit "${2:-1}"
}

[ "${EUID:-$(id -u)}" -eq 0 ] || die "Executor must run as root."
[ "$#" -eq 3 ] || [ "$#" -eq 4 ] || die "Expected ACTION YYYY-MM-DD TARGET [RACES]." 64
action="$1"
target_date="$2"
shard="$3"

case "$action" in
  dummy|fetch|recovery-all|recovery-failed|supplement) ;;
  *) die "Unsupported action." 64 ;;
esac
if [[ ! "$target_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
  [ "$(date -d "$target_date" +%F 2>/dev/null || true)" != "$target_date" ]; then
  die "Invalid date." 64
fi
supplement_races=
if [ "$action" = supplement ]; then
  [ "$#" -eq 4 ] || die "Supplement requires VENUE RACES." 64
  venue="$shard"
  supplement_races="$4"
  [[ "$venue" =~ ^(kiryu|toda|heiwajima|tokoname|biwako|naruto|shimonoseki|wakamatsu|ashiya|fukuoka|karatsu|omura)$ ]] || die "Invalid venue." 64
  [[ "$supplement_races" =~ ^([1-9]|1[0-2])(,([1-9]|1[0-2])){0,11}$ ]] || die "Invalid race list (maximum twelve)." 64
  venues=("$venue")
  case "$venue" in kiryu|ashiya|shimonoseki|toda|wakamatsu) shard=east ;; *) shard=west ;; esac
else
  [ "$#" -eq 3 ] || die "Unexpected fourth argument." 64
  case "$shard" in
    east) venues=(kiryu ashiya shimonoseki toda wakamatsu) ;;
    west) venues=(tokoname omura karatsu fukuoka heiwajima biwako naruto) ;;
    *) die "Invalid shard." 64 ;;
  esac
fi

if [ "$action" = fetch ] || [[ "$action" == recovery-* ]]; then
  [ -f "$enable_file" ] || die "Production morning fetch is disabled." 69
  [ "$(cat "$enable_file")" = ENABLED ] || die "Production enable marker is invalid." 69
  [ "$target_date" = "$(TZ=Asia/Tokyo date +%F)" ] ||
    die "Production target date must be today in JST." 69
fi
if [ "$action" = fetch ]; then
  now_hm="$(TZ=Asia/Tokyo date +%H%M)"
  if [ $((10#$now_hm)) -lt 600 ] || [ $((10#$now_hm)) -gt 645 ]; then
    die "Production morning fetch may start only from 06:00 through 06:45 JST." 69
  fi
fi
if [ "$action" = supplement ]; then
  [ "$target_date" = "$(TZ=Asia/Tokyo date +%F)" ] || die "Supplement target date must be today in JST." 69
fi

live_is_safe() {
  systemctl is-active --quiet sinz-live-fetch.service || return 1
  live_pid="$(systemctl show sinz-live-fetch.service -p MainPID --value)"
  [[ "$live_pid" =~ ^[1-9][0-9]*$ ]] || return 1
  [ -r "/proc/$live_pid/stat" ] || return 1
  available_kb="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
  [ "${available_kb:-0}" -ge 1048576 ] || return 1
  load_one="$(cut -d' ' -f1 /proc/loadavg)"
  cpu_count="$(nproc)"
  awk -v load_one="$load_one" -v cpus="$cpu_count" 'BEGIN {exit !(load_one <= cpus)}'
}

if [[ "$action" == recovery-* ]] || [ "$action" = supplement ]; then
  live_is_safe || die "LIVE safety preflight failed; recovery was not started." 78
fi

install -d -o "$worker_user" -g "$worker_group" -m 0750 "$guard_root"
readonly lock_file="$guard_root/${shard}.lock"
exec 9>"$lock_file"
flock -n 9 || die "Another morning fetch is already running for this shard." 75
if [[ "$action" == recovery-* ]] || [ "$action" = supplement ]; then
  exec 8>"$guard_root/recovery.lock"
  flock -n 8 || die "Another manual recovery is already running." 75
fi

cache_root="$state_root/artifacts/$target_date/$shard"
install -d -o "$worker_user" -g "$worker_group" -m 0750 "$cache_root"

run_dir="$(mktemp -d "$state_root/work/${action}-${target_date}-${shard}.XXXXXXXX")"
cleanup() {
  rm -rf -- "$run_dir"
}
trap cleanup EXIT
chown "$worker_user:$worker_group" "$run_dir"

unit="sinz-morning-${action}-${shard}-$(date +%s)-$$"
cpu_quota=50%
memory_max=1536M
nice_level=10
io_weight=10
if [[ "$action" == recovery-* ]] || [ "$action" = supplement ]; then
  cpu_quota=25%
  memory_max=1024M
  nice_level=15
  io_weight=5
fi
common_properties=(
  --property="User=$worker_user"
  --property="Group=$worker_group"
  --property="WorkingDirectory=$app_root"
  --property="Environment=HOME=$state_root"
  --property="Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/sinz-morning-fetch/playwright"
  --property="NoNewPrivileges=yes"
  --property="PrivateTmp=yes"
  --property="ProtectHome=yes"
  --property="ProtectSystem=strict"
  --property="ReadWritePaths=$run_dir $guard_root"
  --property="CPUQuota=$cpu_quota"
  --property="MemoryMax=$memory_max"
  --property="TasksMax=256"
  --property="Nice=$nice_level"
  --property="IOWeight=$io_weight"
)

if [[ "$action" == recovery-* ]] || [ "$action" = supplement ]; then
  common_properties+=(
    --property="ReadOnlyPaths=$cache_root"
  )
fi

if [ "$action" = dummy ]; then
  command=(
    "$venv_python" automation/make_dummy_morning_artifact.py
    --date "$target_date" --shard "$shard" --output "$run_dir"
  )
  timeout_value=5m
elif [ "$action" = supplement ]; then
  venue_name="$($venv_python -c 'import json,sys; p=json.load(open(sys.argv[1], encoding="utf-8")); print(next(v["name"] for v in p["venues"] if v["slug"] == sys.argv[2]))' "$app_root/automation/venues.json" "$venue")"
  source="$cache_root/$venue_name/${target_date//-/}"
  destination="$run_dir/work/races/$venue_name/${target_date//-/}"
  install -d -o "$worker_user" -g "$worker_group" -m 0750 "$destination/races"
  IFS=, read -r -a requested_races <<<"$supplement_races"
  missing=()
  for race_no in "${requested_races[@]}"; do
    printf -v prefix 'race_%02d' "$race_no"
    complete=true
    for suffix in _boaters_local_st.json _data.txt _motor.txt; do
      [ -f "$source/races/${prefix}${suffix}" ] || complete=false
    done
    if [ "$complete" = true ] && ! "$venv_python" \
      "$app_root/automation/validate_boaters_supplement.py" \
      --race-dir "$source/races" --races "$race_no" >&2; then
      complete=false
    fi
    if [ "$complete" = true ]; then
      find "$source/races" -maxdepth 1 -type f -name "${prefix}_*" -exec cp -a -t "$destination/races" -- {} +
    else
      missing+=("$race_no")
    fi
  done
  chown -R "$worker_user:$worker_group" "$run_dir/work"
  if [ "${#missing[@]}" -eq 0 ]; then
    command=(/usr/bin/true)
  else
    missing_csv="$(IFS=,; echo "${missing[*]}")"
    command=("$venv_python" automation/boaters_fetch.py --stadium "$venue" --date "$target_date" --root "$run_dir/work/races" --races "$missing_csv" --wait 6 --click-wait 1.5)
  fi
  timeout_value="$((120 + ${#missing[@]} * 150))s"
else
  recovery_scope=
  if [ "$action" = fetch ]; then
    fetch_deadline_epoch="$(TZ=Asia/Tokyo date -d "$target_date 08:15" +%s)"
    outer_deadline_epoch="$(TZ=Asia/Tokyo date -d "$target_date 08:18" +%s)"
    outer_timeout_seconds=$((outer_deadline_epoch - $(date +%s)))
    [ "$outer_timeout_seconds" -gt 0 ] || die "Morning fetch deadline has passed." 69
  else
    recovery_scope="${action#recovery-}"
    fetch_deadline_epoch=$(($(date +%s) + 1500))
    outer_timeout_seconds=1560
  fi
  challenge_file="$guard_root/security-challenge-$target_date"
  live_stop_file="$guard_root/live-safety-stop-$target_date"
  fetch_script="$run_dir/fetch-shard.sh"
  {
    echo '#!/usr/bin/env bash'
    echo 'set -uo pipefail'
    printf 'challenge_file=%q\n' "$challenge_file"
    printf 'live_stop_file=%q\n' "$live_stop_file"
    printf 'deadline=%q\n' "$fetch_deadline_epoch"
    printf 'recovery_scope=%q\n' "$recovery_scope"
    printf 'cache_root=%q\n' "$cache_root"
    if [ -n "$recovery_scope" ]; then
      cat <<'SAFETY'
live_is_safe() {
  systemctl is-active --quiet sinz-live-fetch.service || return 1
  live_pid="$(systemctl show sinz-live-fetch.service -p MainPID --value)"
  [[ "$live_pid" =~ ^[1-9][0-9]*$ ]] || return 1
  [ -r "/proc/$live_pid/stat" ] || return 1
  available_kb="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
  [ "${available_kb:-0}" -ge 1048576 ] || return 1
  load_one="$(cut -d' ' -f1 /proc/loadavg)"
  cpu_count="$(nproc)"
  awk -v load_one="$load_one" -v cpus="$cpu_count" 'BEGIN {exit !(load_one <= cpus)}'
}
SAFETY
    fi
    printf 'for venue in'
    printf ' %q' "${venues[@]}"
    echo '; do'
    echo '  if [ -n "$recovery_scope" ] && { [ -e "$live_stop_file" ] || ! live_is_safe; }; then'
    echo '    : > "$live_stop_file"'
    printf '    %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason live_safety_stop --if-missing\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '    continue'
    echo '  fi'
    echo '  if [ -e "$challenge_file" ]; then'
    printf '    %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason security_challenge_global_stop --if-missing\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '    continue'
    echo '  fi'
    if [ -n "$recovery_scope" ]; then
      printf '  %q automation/prepare_morning_recovery_cache.py --cache-root "$cache_root" --run-root %q --venue "$venue" --date %q --scope "$recovery_scope"\n' \
        "$venv_python" "$run_dir/work/races" "$target_date"
      echo '  selection_rc=$?'
      echo '  if [ "$selection_rc" -eq 10 ] || [ "$selection_rc" -eq 11 ]; then continue; fi'
      echo '  if [ "$selection_rc" -ne 0 ]; then'
      printf '    %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason recovery_cache_validation_failed --if-missing\n' \
        "$venv_python" "$target_date" "$run_dir/work/races"
      echo '    exit "$selection_rc"'
      echo '  fi'
    fi
    echo '  while true; do'
    echo '  remaining=$((deadline - $(date +%s)))'
    echo '  if [ "$remaining" -le 90 ]; then'
    printf '    reason=%q\n' "$([ -n "$recovery_scope" ] && echo recovery_timeout || echo cutoff_before_live)"
    printf '    %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason "$reason" --count-existing\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '    break'
    echo '  fi'
    echo '  venue_timeout=$((remaining - 60))'
    if [ -n "$recovery_scope" ]; then
      echo '  if [ "$venue_timeout" -gt 240 ]; then venue_timeout=240; fi'
    else
      echo '  if [ "$venue_timeout" -gt 900 ]; then venue_timeout=900; fi'
    fi
    printf '  /usr/bin/timeout --signal=TERM --kill-after=20s "${venue_timeout}s" %q automation/fetch_one.py --venue "$venue" --date %q --root %q\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '  rc=$?'
    echo '  if [ "$rc" -eq 86 ]; then'
    echo '    : > "$challenge_file"'
    echo '  fi'
    echo '  if [ "$rc" -eq 124 ]; then'
    printf '    %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason recovery_timeout --count-existing\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '  else'
    printf '    %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason fetch_failed_without_status --if-missing\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '  fi'
    echo '  if [ "$rc" -eq 0 ] || [ "$rc" -eq 86 ] || [ -z "$recovery_scope" ]; then break; fi'
    echo '  if [ "$rc" -ne 124 ]; then break; fi'
    echo '  if [ -e "$live_stop_file" ] || ! live_is_safe; then'
    echo '    : > "$live_stop_file"'
    echo '    break'
    echo '  fi'
    echo '  done'
    echo 'done'
  } >"$fetch_script"
  chown "$worker_user:$worker_group" "$fetch_script"
  chmod 0500 "$fetch_script"
  command=(/usr/bin/bash "$fetch_script")
  timeout_value="${outer_timeout_seconds}s"
fi

set +e
systemd-run --quiet --collect --wait --pipe --service-type=exec \
  --unit="$unit" "${common_properties[@]}" \
  /usr/bin/timeout --signal=TERM --kill-after=30s "$timeout_value" \
  "${command[@]}" >&2
unit_rc=$?
set -e

if [ "$action" = supplement ] && [ "$unit_rc" -eq 0 ]; then
  supplement_race_dir="$run_dir/work/races/$venue_name/${target_date//-/}/races"
  supplement_report="$run_dir/work/races/$venue_name/${target_date//-/}/supplement_validation.json"
  set +e
  "$venv_python" "$app_root/automation/validate_boaters_supplement.py" \
    --race-dir "$supplement_race_dir" --races "$supplement_races" \
    --report "$supplement_report" >&2
  unit_rc=$?
  set -e
  if [ "$unit_rc" -eq 0 ]; then
    cache_race_dir="$cache_root/$venue_name/${target_date//-/}/races"
    install -d -o "$worker_user" -g "$worker_group" -m 0750 "$cache_race_dir"
    for race_no in "${missing[@]}"; do
      printf -v prefix 'race_%02d' "$race_no"
      backup_dir="$cache_root/.replaced-invalid/$(date +%Y%m%dT%H%M%S)/$venue_name/${prefix}"
      if find "$cache_race_dir" -maxdepth 1 -type f -name "${prefix}_*" -print -quit | grep -q .; then
        install -d -o root -g root -m 0700 "$backup_dir"
        find "$cache_race_dir" -maxdepth 1 -type f -name "${prefix}_*" \
          -exec mv -t "$backup_dir" -- {} +
      fi
      find "$supplement_race_dir" -maxdepth 1 -type f -name "${prefix}_*" \
        -exec cp -a -t "$cache_race_dir" -- {} +
    done
    chown -R "$worker_user:$worker_group" "$cache_race_dir"
  fi
fi

if { [ "$action" = fetch ] || [[ "$action" == recovery-* ]]; } && [ "$unit_rc" -ne 0 ]; then
  for venue in "${venues[@]}"; do
    "$venv_python" "$app_root/automation/write_morning_fetch_status.py" \
      --venue "$venue" --date "$target_date" --root "$run_dir/work/races" \
      --reason executor_timeout_or_failure --if-missing
  done
fi

if { [ "$action" = fetch ] || [[ "$action" == recovery-* ]]; } && [ "$unit_rc" -eq 0 ]; then
  for venue in "${venues[@]}"; do
    venue_name="$($venv_python -c 'import json,sys; p=json.load(open(sys.argv[1], encoding="utf-8")); print(next(v["name"] for v in p["venues"] if v["slug"] == sys.argv[2]))' "$app_root/automation/venues.json" "$venue")"
    source="$run_dir/work/races/$venue_name/${target_date//-/}"
    destination="$cache_root/$venue_name/${target_date//-/}"
    if [ -d "$source" ]; then
      rm -rf -- "$destination"
      install -d -o "$worker_user" -g "$worker_group" -m 0750 "$(dirname "$destination")"
      cp -a "$source" "$destination"
      chown -R "$worker_user:$worker_group" "$destination"
    fi
  done
fi

if [[ "$action" == recovery-* ]] && [ "$unit_rc" -ne 0 ]; then
  die "Recovery executor failed; cached artifacts were left unchanged." 70
fi
if [ "$action" = supplement ] && [ "$unit_rc" -ne 0 ]; then
  die "Supplement executor stopped safely; cached artifacts were left unchanged." 70
fi

if [ "$action" = dummy ]; then
  tar --create --gzip --directory="$run_dir" --file=- work
else
  (
    cd "$run_dir"
    find work/races -type f \
      \( -name fetch_status.json -o -name tide_today.json \
      -o -name '*_entry.txt' -o -name '*_entry.html' \
      -o -name '*_data.txt' -o -name '*_motor.txt' \
      -o -name '*_boaters_local_st.json' \
      -o -name '*_boaters_local_st_clicked.html' \
      -o -name '*_boaters_local_st_clicked.txt' \
      -o -name supplement_validation.json \) -print0 |
      tar --null --create --gzip --file=- --files-from=-
  )
fi
