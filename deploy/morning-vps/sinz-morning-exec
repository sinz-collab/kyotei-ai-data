#!/usr/bin/env bash
set -euo pipefail

readonly app_root=/opt/sinz-morning-fetch/app
readonly venv_python=/opt/sinz-morning-fetch/venv/bin/python
readonly state_root=/var/lib/sinz-morning-fetch
readonly enable_file=/etc/sinz-morning-fetch/enabled
readonly guard_root=/run/sinz-morning-fetch
readonly worker_user=sinz-morning
readonly worker_group=sinz-morning

die() {
  echo "$1" >&2
  exit "${2:-1}"
}

[ "${EUID:-$(id -u)}" -eq 0 ] || die "Executor must run as root."
[ "$#" -eq 3 ] || die "Expected ACTION YYYY-MM-DD SHARD." 64
action="$1"
target_date="$2"
shard="$3"

case "$action" in
  dummy|fetch) ;;
  *) die "Unsupported action." 64 ;;
esac
if [[ ! "$target_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
  [ "$(date -d "$target_date" +%F 2>/dev/null || true)" != "$target_date" ]; then
  die "Invalid date." 64
fi
case "$shard" in
  east) venues=(kiryu ashiya shimonoseki toda wakamatsu) ;;
  west) venues=(tokoname omura karatsu fukuoka heiwajima biwako naruto) ;;
  *) die "Invalid shard." 64 ;;
esac

if [ "$action" = fetch ]; then
  [ -f "$enable_file" ] || die "Production morning fetch is disabled." 69
  [ "$(cat "$enable_file")" = ENABLED ] || die "Production enable marker is invalid." 69
  [ "$target_date" = "$(TZ=Asia/Tokyo date +%F)" ] ||
    die "Production target date must be today in JST." 69
  now_hm="$(TZ=Asia/Tokyo date +%H%M)"
  if [ $((10#$now_hm)) -lt 600 ] || [ $((10#$now_hm)) -gt 645 ]; then
    die "Production morning fetch may start only from 06:00 through 06:45 JST." 69
  fi
fi

install -d -o "$worker_user" -g "$worker_group" -m 0750 "$guard_root"
readonly lock_file="$guard_root/${shard}.lock"
exec 9>"$lock_file"
flock -n 9 || die "Another morning fetch is already running for this shard." 75

run_dir="$(mktemp -d "$state_root/work/${action}-${target_date}-${shard}.XXXXXXXX")"
cleanup() {
  rm -rf -- "$run_dir"
}
trap cleanup EXIT
chown "$worker_user:$worker_group" "$run_dir"

unit="sinz-morning-${action}-${shard}-$(date +%s)-$$"
common_properties=(
  --property="User=$worker_user"
  --property="Group=$worker_group"
  --property="WorkingDirectory=$app_root"
  --property="Environment=HOME=$state_root"
  --property="Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/sinz-morning-fetch/playwright"
  --property="NoNewPrivileges=yes"
  --property="PrivateTmp=yes"
  --property="ProtectHome=yes"
  --property="ProtectSystem=strict"
  --property="ReadWritePaths=$run_dir $guard_root"
  --property="CPUQuota=50%"
  --property="MemoryMax=1536M"
  --property="TasksMax=256"
  --property="Nice=10"
  --property="IOWeight=10"
)

if [ "$action" = dummy ]; then
  command=(
    "$venv_python" automation/make_dummy_morning_artifact.py
    --date "$target_date" --shard "$shard" --output "$run_dir"
  )
  timeout_value=5m
else
  fetch_deadline_epoch="$(TZ=Asia/Tokyo date -d "$target_date 08:15" +%s)"
  outer_deadline_epoch="$(TZ=Asia/Tokyo date -d "$target_date 08:18" +%s)"
  outer_timeout_seconds=$((outer_deadline_epoch - $(date +%s)))
  [ "$outer_timeout_seconds" -gt 0 ] || die "Morning fetch deadline has passed." 69
  challenge_file="$guard_root/security-challenge-$target_date"
  fetch_script="$run_dir/fetch-shard.sh"
  {
    echo '#!/usr/bin/env bash'
    echo 'set -uo pipefail'
    printf 'challenge_file=%q\n' "$challenge_file"
    printf 'deadline=%q\n' "$fetch_deadline_epoch"
    printf 'for venue in'
    printf ' %q' "${venues[@]}"
    echo '; do'
    echo '  if [ -e "$challenge_file" ]; then'
    printf '    %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason security_challenge_global_stop --if-missing\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '    continue'
    echo '  fi'
    echo '  remaining=$((deadline - $(date +%s)))'
    echo '  if [ "$remaining" -le 90 ]; then'
    printf '    %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason cutoff_before_live\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '    continue'
    echo '  fi'
    echo '  venue_timeout=$((remaining - 60))'
    echo '  if [ "$venue_timeout" -gt 900 ]; then venue_timeout=900; fi'
    printf '  /usr/bin/timeout --signal=TERM --kill-after=20s "${venue_timeout}s" %q automation/fetch_one.py --venue "$venue" --date %q --root %q\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo '  rc=$?'
    echo '  if [ "$rc" -eq 86 ]; then'
    echo '    : > "$challenge_file"'
    echo '  fi'
    printf '  %q automation/write_morning_fetch_status.py --venue "$venue" --date %q --root %q --reason fetch_failed_without_status --if-missing\n' \
      "$venv_python" "$target_date" "$run_dir/work/races"
    echo 'done'
  } >"$fetch_script"
  chown "$worker_user:$worker_group" "$fetch_script"
  chmod 0500 "$fetch_script"
  command=(/usr/bin/bash "$fetch_script")
  timeout_value="${outer_timeout_seconds}s"
fi

set +e
systemd-run --quiet --collect --wait --pipe --service-type=exec \
  --unit="$unit" "${common_properties[@]}" \
  /usr/bin/timeout --signal=TERM --kill-after=30s "$timeout_value" \
  "${command[@]}" >&2
unit_rc=$?
set -e

if [ "$action" = fetch ] && [ "$unit_rc" -ne 0 ]; then
  for venue in "${venues[@]}"; do
    "$venv_python" "$app_root/automation/write_morning_fetch_status.py" \
      --venue "$venue" --date "$target_date" --root "$run_dir/work/races" \
      --reason executor_timeout_or_failure --if-missing
  done
fi

if [ "$action" = dummy ]; then
  tar --create --gzip --directory="$run_dir" --file=- work
else
  (
    cd "$run_dir"
    find work/races -type f \
      \( -name fetch_status.json -o -name tide_today.json \
      -o -name '*_entry.txt' -o -name '*_entry.html' \
      -o -name '*_data.txt' -o -name '*_motor.txt' \
      -o -name '*_boaters_local_st.json' \) -print0 |
      tar --null --create --gzip --file=- --files-from=-
  )
fi
