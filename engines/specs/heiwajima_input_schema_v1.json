{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heiwajima engine input",
  "type": "object",
  "required": [
    "race_date",
    "race_no",
    "boats"
  ],
  "properties": {
    "race_date": {
      "type": "string"
    },
    "race_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "stage": {
      "enum": [
        "pre",
        "final"
      ]
    },
    "boats": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "boat_no",
          "reg_no",
          "player_name"
        ],
        "properties": {
          "boat_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "actual_course": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 6
          },
          "reg_no": {
            "type": [
              "string",
              "integer"
            ]
          },
          "player_name": {
            "type": "string"
          },
          "motor": {
            "type": "object"
          },
          "season": {
            "type": "object"
          },
          "exhibition": {
            "type": "object"
          }
        }
      }
    },
    "tide": {
      "type": "object"
    },
    "weather": {
      "type": "object"
    },
    "odds": {
      "type": "object"
    }
  }
}